{
  "name": "canvas-wasi",
  "version": "0.1.3",
  "description": "HTML5 Canvas and software framebuffer graphics bridge for WebAssembly & WASI, powered by canvas-window",
  "dependencies": {
    "canvas-window": "github:breeze833/canvas-window"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./worker": {
      "types": "./types/index.d.ts",
      "import": "./src/worker.js"
    },
    "./headers": {
      "import": "./src/headers.js"
    },
    "./style.css": "./src/ui/style.css"
  },
  "files": [
    "include",
    "src",
    "types",
    "SPEC.md",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/canvas-wasi.test.js",
    "demo": "node examples/serve.js",
    "start": "node examples/serve.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/breeze833/canvas-wasi.git"
  },
  "keywords": [
    "wasi",
    "wasm",
    "webassembly",
    "canvas",
    "graphics",
    "framebuffer",
    "2d"
  ],
  "author": "breeze833",
  "license": "MIT"
}
